# Copy to .env or .env.local (both gitignored).
# See docs/newCompanion-llm-cloud-guide.md — same as JudgmentOS.

# 必填：密钥（二选一）
LLM_API_KEY=
# 或（AI Builders 部署时平台自动注入，不要手写进部署 env_vars）
# AI_BUILDER_TOKEN=

# 推荐显式写清
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://space.ai-builders.com/backend/v1
LLM_MODEL=grok-4-fast

# Optional: LAN / iPhone
# COMPANION_HOST=0.0.0.0
# COMPANION_PORT=8765
